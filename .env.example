# ==============================================================================
# Copie este archivo a .env y complete los valores marcados con CAMBIAR:
#   cp .env.example .env
# .env está en .gitignore: nunca lo suba al repositorio.
# ==============================================================================

# ==============================================================================
# Entorno de ejecución
# ==============================================================================
ENVIRONMENT=production

# ==============================================================================
# PostgreSQL 16 / PostGIS 3.4
# ==============================================================================
POSTGRES_DB=chicago_safety
POSTGRES_USER=chicago_admin
# CAMBIAR. Genere una clave con (sólo letras, números, - y _ para no romper las URLs):
#   python -c "import secrets; print(secrets.token_urlsafe(24))"
POSTGRES_PASSWORD=CAMBIAR_por_una_clave_larga
# Dentro de Docker el host es "db"; desde la terminal del host es "localhost"
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
# Puerto del equipo donde se publica PostgreSQL (sólo en 127.0.0.1)
POSTGRES_HOST_PORT=5432

# URLs Dual-Engine (asyncpg para la API, psycopg3 para Alembic / ETL).
# docker-compose.yml las construye automáticamente para los contenedores; estas
# sólo se usan al ejecutar código Python directamente en el host.
# Ponga aquí la MISMA clave que en POSTGRES_PASSWORD.
DATABASE_URL=postgresql+asyncpg://chicago_admin:CAMBIAR_por_una_clave_larga@localhost:5432/chicago_safety
SYNC_DATABASE_URL=postgresql+psycopg://chicago_admin:CAMBIAR_por_una_clave_larga@localhost:5432/chicago_safety

# ==============================================================================
# Chicago Open Data (Socrata SODA). Opcional: un App Token eleva la cuota de peticiones
# ==============================================================================
SOCRATA_APP_TOKEN=

# ==============================================================================
# Servidores
# ==============================================================================
# Procesos Uvicorn de la API (~300-400 MB cada uno; el contenedor tiene 2 GB)
WEB_CONCURRENCY=4
# Puerto del equipo donde se publica la web (Nginx)
WEB_PORT=80

# ==============================================================================
# Seguridad web
# ==============================================================================
CORS_ORIGINS=http://localhost,http://localhost:80,http://localhost:3000,http://localhost:5173
